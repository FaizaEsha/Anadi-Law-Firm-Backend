# Example only. Use a secret manager or a protected environment file on the server.
DJANGO_SETTINGS_MODULE=config.production
PRODUCTION_SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
PRODUCTION_ALLOWED_HOSTS=api.your-company.example
PRODUCTION_CORS_ALLOWED_ORIGINS=https://your-company.example
PRODUCTION_CSRF_TRUSTED_ORIGINS=https://api.your-company.example
PRODUCTION_DATA_ROOT=/srv/anadi-data
PRODUCTION_HSTS_SECONDS=3600
# Base SECRET_KEY is required while importing shared settings; use the same secure value.
SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DB_NAME=lawfirm_production
DB_USER=lawfirm_production_user
DB_PASSWORD=SET_IN_SECRET_MANAGER
DB_HOST=127.0.0.1
DB_PORT=3306
